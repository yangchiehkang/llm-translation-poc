# 系统级 systemd 单元（需管理员安装）。安装到 /etc/systemd/system/translation-api.service
# 启用：sudo systemctl daemon-reload && sudo systemctl enable --now translation-api
# 与 user 版等价，区别仅在 User= 指定运行身份、开机自启无需 linger。
[Unit]
Description=GangZhongShen Regulation Translation API (wrapper over existing translation code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yinzs
Group=yinzs
WorkingDirectory=PROJECT_ROOT
EnvironmentFile=PROJECT_ROOT/.env
Environment=PYTHONPATH=PROJECT_ROOT
ExecStart=/data/SERVICE_USER/translation-api/venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8188 --workers 1 --log-level info
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

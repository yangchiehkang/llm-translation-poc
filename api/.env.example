# 复制为项目根目录下的 .env，chmod 600，已在 .gitignore 中。切勿提交真实密钥。
# systemd 用 EnvironmentFile 加载本文件，不从 .bashrc 取。

# ---- 后端开关 ----
BACKEND=dashscope
# BACKEND=local_npu

# ---- 网络：优先 IPv4（规避本机 IPv6 到 dashscope 不通导致的 ~63s SYN 超时）----
PREFER_IPV4=true

# ---- 鉴权 token（支持多个，逗号分隔：国创一个、自测一个）----
API_TOKENS=REPLACE_WITH_GUOCHUANG_TOKEN,REPLACE_WITH_SELFTEST_TOKEN

# ---- dashscope 云 API 密钥（后端为 dashscope 时必填）----
DASHSCOPE_API_KEY=REPLACE_WITH_DASHSCOPE_KEY

# ---- 服务监听 ----
HOST=0.0.0.0
PORT=8188

# ---- 路由路径（可配置）----
LAW_PATH=/openApi/translate/law
TERMINOLOGY_LIST_PATH=/openApi/terminology/list

# ---- 术语库 & 行为开关 ----
TERMBASE_PATH=termbase/auto_regulation_terms_v1.csv
TERMINOLOGY_LIST_AS_OBJECT=false

# ---- 长文本上限（保守值，本期承诺值）----
MAX_TEXT_CHARS=8000

# ---- 模型参数 ----
MODEL_NAME=qwen-max
TEMPERATURE=0.2
MAX_TOKENS=2048
TIMEOUT=120
RETRIES=3

# ---- local_npu 后端（本期不做模型选型；若启用则指向本地 OpenAI 兼容服务）----
LOCAL_NPU_BASE_URL=
LOCAL_NPU_MODEL=
LOCAL_NPU_API_KEY=EMPTY

# ---- 日志 ----
LOG_DIR=/data/SERVICE_USER/translation-api/logs
LOG_LEVEL=INFO
SOURCE_LOG_CHARS=200
